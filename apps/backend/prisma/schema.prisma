generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                 String             @id @default(cuid())
  fullName           String
  email              String             @unique
  passwordHash       String
  country            String?
  preferredCurrency  String             @default("PKR")
  stakeUsername      String?
  phone              String?
  experienceLevel    String?

  role               UserRole           @default(USER)
  status             UserStatus         @default(PENDING)
  subscriptionStatus SubscriptionStatus @default(NONE)

  emailVerified      Boolean            @default(false)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  bets               Bet[]
  connections        BookmakerConnection[]

  @@index([email])
  @@index([status])
}

model BookmakerConnection {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  tokenHash String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Bet {
  id        String   @id @default(cuid())
  userId    String
  n         Int
  placedAt  DateTime
  match     String
  market    String
  odds      Float
  stake     Float
  currency  String   @default("PKR")
  result    String
  flag      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, placedAt])
}

model InsightReport {
  id            String   @id @default(cuid())
  userId        String
  investorScore Float
  rating        String
  totalBets     Int
  totalStaked   Float
  totalReturned Float
  roi           Float
  winRate       Float
  createdAt     DateTime @default(now())
}

model InsightMetricScore {
  id        String   @id @default(cuid())
  userId    String
  code      String
  title     String
  score     Float
  weight    Float
  summary   String
  stats     Json
  createdAt DateTime @default(now())
}

model TiltEvent {
  id        String   @id @default(cuid())
  userId    String
  title     String
  subtitle  String
  startAt   DateTime
  endAt     DateTime
  betCount  Int
  signals   Json
  createdAt DateTime @default(now())
}